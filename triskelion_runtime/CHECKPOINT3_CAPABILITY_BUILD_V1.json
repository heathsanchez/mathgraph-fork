{
  "protocol": "TRISKELION_BUGSINPY_CHECKPOINT3_CAPABILITY_BUILD_V1",
  "causal_protocol": "TRISKELION_BUGSINPY_CHECKPOINT3_CAUSAL_V1",
  "frozen_before_protected_evaluation": true,
  "input_split": "acquisition",
  "protected_access_during_build": "forbidden",
  "compiler": {
    "provider": "river",
    "model": "Qwen/Qwen3.5-9B",
    "temperature": 0.0,
    "max_tokens": 2048,
    "seed_base": 20260818,
    "calls_per_acquisition_case": 1,
    "retry_on_invalid_output": false,
    "provider_failure": "abort_build"
  },
  "acquisition_visibility": {
    "full_buggy_tree": false,
    "full_fixed_tree": false,
    "buggy_source_context_from_gold_diff": true,
    "fixed_source_context_from_gold_diff": true,
    "buggy_regression_output": true,
    "fixed_regression_output": true,
    "gold_diff": true
  },
  "evidence_reconstruction": {
    "source": "finalized immutable qualification attempts plus exact buggy-to-fixed git diff",
    "rerun_historical_provisioning": false,
    "git_diff_command": "git diff --no-ext-diff --unified=5 BUGGY FIXED --",
    "reconstruction_failure": "abort_build",
    "max_gold_diff_chars": 24000,
    "max_buggy_regression_chars": 12000,
    "max_fixed_regression_chars": 6000,
    "truncation": "head_tail_equal_halves_with_explicit_omission_marker"
  },
  "rule_schema": {
    "required_fields": [
      "title",
      "required_any",
      "required_all",
      "forbidden_any",
      "repair_instruction"
    ],
    "allow_extra_fields": false,
    "max_rules_per_case": 1,
    "max_signatures_per_field": 8,
    "signature_min_chars": 2,
    "signature_max_chars": 80,
    "repair_instruction_max_chars": 1200,
    "require_at_least_one_positive_signature": true
  },
  "identity_leakage_policy": {
    "forbid_project_name": true,
    "forbid_bug_id": true,
    "forbid_commit_hashes": true,
    "forbid_absolute_paths": true,
    "forbid_exact_fixed_patch": true
  },
  "admission_policy": {
    "admit_every_schema_valid_compiler_output": true,
    "manual_rule_selection": "forbidden",
    "manual_rule_editing": "forbidden",
    "manual_rule_deletion": "forbidden",
    "invalid_compiler_output": "record_compile_failure_and_continue",
    "minimum_admitted_rules_for_protected_evaluation": 1
  },
  "scope_policy": {
    "normalization": "unicode_casefold_then_whitespace_collapse",
    "positive_rule": "all required_all signatures and at least one required_any signature match; when required_any is empty, nonempty required_all is sufficient",
    "negative_rule": "no forbidden_any signature may match",
    "matching": "literal_substring",
    "verified_context": "only matching admitted rules",
    "always_on_context": "all admitted rules"
  },
  "raw_memory_policy": {
    "representation": "deterministic acquisition evidence records containing failure summary and gold diff",
    "manual_selection": "forbidden",
    "ordering": "frozen acquisition project order"
  },
  "capability_id": "sha256_of_canonical_compiler_protocol_plus_all_admitted_rules_and_compile_failures"
}
